{
  "name": "orbtasoft-automation",
  "version": "1.0.0",
  "description": "Orbtasoft Appointment Automation Desktop App",
  "main": "src/main.js",
  "author": {
    "name": "Orbtasoft Team",
    "email": "support@orbtasoft.com"
  },
  "homepage": "https://github.com/orbtasoft/automation",
  "license": "MIT",
  "scripts": {
    "start":            "electron .",
    "dev":              "electron . --dev",
    "build:mac":        "electron-builder --mac --x64 --arm64",
    "build:win":        "electron-builder --win --x64",
    "build:linux":      "electron-builder --linux --x64",
    "build:linux:deb":  "electron-builder --linux deb --x64",
    "build:linux:rpm":  "electron-builder --linux rpm --x64",
    "build:linux:snap": "electron-builder --linux snap --x64",
    "build:linux:tar":  "electron-builder --linux tar.gz --x64",
    "build:linux:all":  "electron-builder --linux AppImage deb rpm snap tar.gz --x64",
    "build:all":        "electron-builder --mac --win --linux --x64"
  },
  "build": {
    "appId":       "com.orbtasoft.automation",
    "productName": "Orbtasoft Automation",
    "copyright":   "Copyright © 2025",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] },
        { "target": "rpm",      "arch": ["x64"] },
        { "target": "snap",     "arch": ["x64"] },
        { "target": "tar.gz",   "arch": ["x64"] }
      ],
      "category": "Utility",
      "synopsis": "Orbtasoft Appointment Automation Tool",
      "description": "Automated appointment booking system for Orbtasoft services",
      "maintainer": "Orbtasoft Team <support@orbtasoft.com>",
      "desktop": {
        "Name": "Orbtasoft Automation",
        "Type": "Application",
        "Categories": "Utility;Office;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid"
      ]
    },
    "snap": {
      "confinement": "classic",
      "grade": "stable"
    }
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
