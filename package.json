{
  "name": "austria-appointment-bot",
  "version": "1.0.0",
  "description": "Austria BMEIA Appointment Automation Desktop App",
  "main": "src/main.js",
  "scripts": {
    "start":     "electron .",
    "dev":       "electron . --dev",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder --mac --win --x64"
  },
  "build": {
    "appId":       "com.austria.appointment-bot",
    "productName": "Austria Appointment Bot",
    "copyright":   "Copyright © 2025",
    "directories": { "output": "dist" },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "devDependencies": {
    "electron":         "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
